<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>ControllerHub.Obs</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ControllerHub.PluginContract\ControllerHub.PluginContract.csproj">
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>
  <Target Name="CopyToHostPlugins" AfterTargets="Build">
    <PropertyGroup>
      <HostPluginsDir>$(SolutionDir)ControllerHub\bin\$(Configuration)\net8.0-windows10.0.22621.0\plugins\</HostPluginsDir>
    </PropertyGroup>
    <MakeDir Directories="$(HostPluginsDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(HostPluginsDir)" />
    <Copy SourceFiles="@(ReferenceCopyLocalPaths->WithMetadataValue('Filename', 'Newtonsoft.Json'))" DestinationFolder="$(HostPluginsDir)" />
  </Target>
</Project>
